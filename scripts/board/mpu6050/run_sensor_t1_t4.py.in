#!/usr/bin/env python3
"""Explicit bounded T1-T4 window, parent controller holds board lock.
No coldboot/reset/retry; failure preserves loaded references for controlled recovery.
"""
import hashlib,json,os,pathlib,selectors,signal,subprocess,time
BASE=pathlib.Path('/boot/amp-p029/mpu-sensor-v1')
APP=pathlib.Path('/home/cat/cockpit/mpu-sensor-app-v2/build/apps/cockpit_ui/sensor_stream_probe')
WINDOW_END=float('inf')
def need(ok,reason):
 if not ok:raise RuntimeError('SENSOR_STOP '+reason)
def remaining():
 value=WINDOW_END-time.monotonic();need(value>0,'whole runner300s deadline');return value
def command(args,seconds):subprocess.run(args,check=True,timeout=min(seconds,remaining()))
def health():
 p=pathlib.Path('/sys/module/rk3576_amp_health_test/parameters/health_status')
 text=p.read_text().strip();print('SENSOR_HEALTH',text,flush=True)
 fields=dict(x.split('=',1) for x in text.split() if '=' in x)
 need(fields.get('bound')=='1' and fields.get('phase') not in ('FAILED','STOPPED','UNBOUND'),'health failed')
 need(fields.get('timeout')=='0' and fields.get('error')=='0','health timeout/error')
 if int(fields.get('pong','0')):need(int(fields['last_pong_age_ms'])<3000,'health stale')
 return fields

def samples(number):
 process=subprocess.Popen(['runuser','-u','cat','--',str(APP),'--device','/dev/rk3576-sensor-v1','--samples',str(number),'--window-ms','120000'],stdout=subprocess.PIPE,stderr=subprocess.STDOUT,start_new_session=True)
 selector=selectors.DefaultSelector();selector.register(process.stdout,selectors.EVENT_READ);deadline=min(WINDOW_END,time.monotonic()+125);budget=256*1024;last_health=0;pending=b''
 try:
  while selector.get_map():
   need(time.monotonic()<deadline,'client deadline')
   if time.monotonic()-last_health>=1:
    health();last_health=time.monotonic()
   for key,_ in selector.select(1):
    raw=os.read(key.fd,4096)
    if not raw:
     need(not pending,'client incomplete final line');selector.unregister(key.fileobj);continue
    budget-=len(raw);need(budget>=0,'client log limit');pending+=raw
    while b'\n' in pending:
     line,pending=pending.split(b'\n',1);need(len(line)<=4096,'client line limit');print(line.decode(errors='strict'),flush=True)
    need(len(pending)<=4096,'client partial line limit')
  need(process.wait(timeout=3)==0,'client sample/unsubscribe failure')
 finally:
  if process.poll() is None:
   os.killpg(process.pid,signal.SIGTERM)
   try:process.wait(timeout=3)
   except subprocess.TimeoutExpired:os.killpg(process.pid,signal.SIGKILL);process.wait(timeout=3)
  selector.close();process.stdout.close()

def main():
 global WINDOW_END
 WINDOW_END=time.monotonic()+300
 need(os.geteuid()==0,'root controller required')
 need(APP.is_file() and not APP.is_symlink() and APP.stat().st_size==__APP_BYTES__,'exact application size')
 need(APP.stat().st_size<32*1024*1024,'bounded application file')
 with APP.open('rb') as f:
  digest=hashlib.sha256()
  for raw in iter(lambda:f.read(1024*1024),b''):digest.update(raw)
  need(digest.hexdigest()=='__APP_SHA__','exact application hash')
 command(['python3',str(BASE/'preflight-sensor.py')],10)
 command(['insmod',str(BASE/'rk3576_amp_health_test.ko')],10)
 start=time.monotonic()
 while time.monotonic()-start<10:
  fields=health()
  if fields.get('hello_ack')=='1' and int(fields.get('pong','0'))>=3:break
  time.sleep(.5)
 else:raise RuntimeError('SENSOR_STOP missing baseline health')
 command(['insmod',str(BASE/'rk3576_sensor.ko')],10)
 node=pathlib.Path('/dev/rk3576-sensor-v1');need(node.is_char_device(),'sensor node missing')
 import pwd
 uid=pwd.getpwnam('cat').pw_uid;os.chown(node,uid,-1);os.chmod(node,0o600)
 previous=int(health()['pong']);samples(100);need(int(health()['pong'])>previous,'T3 health progress')
 previous=int(health()['pong']);samples(100);need(int(health()['pong'])>previous,'T4 health progress')
 # Each normal client received matching UNSUB RESULT before close. Lease=5s fallback.
 previous=int(health().get('pong','0'));time.sleep(1)
 need(int(health().get('pong','0'))>previous,'health stalled during stream')
 command(['rmmod','rk3576_sensor'],10);command(['rmmod','rk3576_amp_health_test'],10)
 need(not pathlib.Path('/sys/module/rk3576_sensor').exists() and not node.exists(),'sensor cleanup')
 print('SENSOR_T1_T4_LINUX_EXIT_PASS; M0 UART WHO/config/raw correlation and cold default recovery still required',flush=True)
if __name__=='__main__':main()
