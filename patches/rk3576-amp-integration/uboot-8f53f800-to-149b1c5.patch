diff --git a/common/amp_project_boot.c b/common/amp_project_boot.c
new file mode 100644
index 0000000..7f8f056
--- /dev/null
+++ b/common/amp_project_boot.c
@@ -0,0 +1,90 @@
+// SPDX-License-Identifier: GPL-2.0+
+/* PROJECT ADDITION: no persistent environment or MMIO changes. */
+#include <common.h>
+#include <command.h>
+#include <image.h>
+#include <amp.h>
+#include <amp_project_boot.h>
+
+DECLARE_GLOBAL_DATA_PTR;
+
+static bool amp_project_policy_initialized;
+static bool amp_project_factory_allowed;
+
+void amp_project_boot_policy_init(void)
+{
+	int node, len, required;
+
+	/* One boot-stage decision, default deny. Environment cannot set it. */
+	if (amp_project_policy_initialized)
+		return;
+	amp_project_policy_initialized = true;
+	amp_project_factory_allowed = false;
+	if (fdt_check_header(gd->fdt_blob))
+		return;
+	node = fdt_path_offset(gd->fdt_blob, "/config");
+	if (node >= 0) {
+		if (fdt_getprop(gd->fdt_blob, node, "bootcmd", &len) ||
+		    len != -FDT_ERR_NOTFOUND)
+			return;
+		if (fdt_getprop(gd->fdt_blob, node, "bootsecure", &len) ||
+		    len != -FDT_ERR_NOTFOUND)
+			return;
+	} else if (node != -FDT_ERR_NOTFOUND) {
+		return;
+	}
+	/* This fixed vendor implementation returns 1 on OP-TEE read failure. */
+	required = fit_board_verify_required_sigs();
+	if (required != 0) {
+		printf("PROJECT: factory boot/CLI closed, policy=%d\n", required);
+		return;
+	}
+	amp_project_factory_allowed = true;
+	puts("PROJECT: factory boot/CLI allowed by runtime policy=0\n");
+}
+
+bool amp_project_factory_boot_allowed(void)
+{
+	return amp_project_policy_initialized && amp_project_factory_allowed;
+}
+
+bool amp_project_console_allowed(void)
+{
+	return amp_project_factory_boot_allowed();
+}
+
+bool amp_project_source_range_valid(ulong addr, ulong size)
+{
+	u64 start, count;
+	int i;
+
+	if (!amp_project_factory_boot_allowed() || !size || (addr & 7) ||
+	    (u64)addr > ~0ULL - size || amp_reserved_range_check(addr, size))
+		return false;
+	for (i = 0; i < CONFIG_NR_DRAM_BANKS; i++) {
+		start = gd->bd->bi_dram[i].start;
+		count = gd->bd->bi_dram[i].size;
+		if (count && start <= ~0ULL - count && addr >= start &&
+		    (u64)addr + size <= start + count)
+			return true;
+	}
+	return false;
+}
+
+static int do_amp_project_boot(cmd_tbl_t *cmdtp, int flag, int argc,
+			       char *const argv[])
+{
+	(void)cmdtp;
+	(void)flag;
+	(void)argv;
+	if (argc != 1)
+		return CMD_RET_USAGE;
+	if (amp_project_factory_boot_allowed())
+		return run_command("run distro_bootcmd", 0);
+	/* Existing signed-FIT loader and verification, never raw fallback. */
+	return run_command("boot_fit", 0);
+}
+
+U_BOOT_CMD(amp_project_boot, 1, 0, do_amp_project_boot,
+	   "PROJECT: runtime policy-gated factory distro or signed FIT",
+	   "");
