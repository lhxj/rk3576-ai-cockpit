+void *sysmem_reserve_amp_region(const char *name, phys_addr_t base,
+			      phys_size_t size)
+{
+	struct sysmem *sysmem = &plat_sysmem;
+	struct lmb *lmb = &sysmem->lmb;
+	struct memblock *mem;
+	char *saved_name;
+	ulong i;
+	bool inside = false;
+
+	/* Do not use sysmem_alloc_align_base's permissive out-of-range return,
+	 * alias matching, same-name shortcut, or overflow-check memory writes. */
+	if (!sysmem_has_init() || !name || !*name || !base || !size ||
+	    (base & 3) || (size & (sizeof(ulong) - 1)) ||
+	    base > (phys_addr_t)-1 - size)
+		return NULL;
+	for (i = 0; i < lmb->memory.cnt; i++) {
+		phys_addr_t start = lmb->memory.region[i].base;
+		phys_size_t length = lmb->memory.region[i].size;
+
+		if (start > (phys_addr_t)-1 - length)
+			return NULL;
+		if (start <= base && base - start <= length &&
+		    size <= length - (base - start))
+			inside = true;
+	}
+	if (!inside)
+		return NULL;
+	for (i = 0; i < lmb->reserved.cnt; i++) {
+		if (lmb->reserved.region[i].base > (phys_addr_t)-1 -
+		    lmb->reserved.region[i].size)
+			return NULL;
+		if (sysmem_is_overlap(base, size, lmb->reserved.region[i].base,
+				      lmb->reserved.region[i].size))
+			return NULL;
+	}
+	/* Bookkeeping lives in the U-Boot heap; reserve before recording it. */
+	mem = calloc(1, sizeof(*mem));
+	if (!mem)
+		return NULL;
+	saved_name = strdup(name);
+	if (!saved_name) {
+		free(mem);
+		return NULL;
+	}
+	if (lmb_reserve(lmb, base, size) < 0) {
+		free(saved_name);
+		free(mem);
+		return NULL;
+	}
+	mem->base = mem->orig_base = base;
+	mem->size = size;
+	mem->attr.name = saved_name;
+	/* Expected Linux no-map reservations describe these same regions.
+	 * They are independently checked against the platform contract on Host. */
+	mem->attr.flags = F_KMEM_CAN_OVERLAP;
+	list_add_tail(&mem->node, &sysmem->allocated_head);
+	sysmem->allocated_cnt++;
+	return (void *)base;
+}
