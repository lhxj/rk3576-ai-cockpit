diff --git a/bsp/rockchip/rk3576-mcu/amp_address.h b/bsp/rockchip/rk3576-mcu/amp_address.h
new file mode 100644
index 0000000..d8c8da4
--- /dev/null
+++ b/bsp/rockchip/rk3576-mcu/amp_address.h
@@ -0,0 +1,19 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+/* Generated constants are shared by linker/ITS/DTS. Cold Host proposal only. */
+#ifndef AMP_ADDRESS_H
+#define AMP_ADDRESS_H
+#include <stdint.h>
+#include "amp_contract.h"
+static inline uint32_t amp_pool_pa_to_m0(uint32_t pa)
+{
+    if (pa < AMP_POOL_LINUX_PA || pa - AMP_POOL_LINUX_PA >= AMP_POOL_SIZE)
+        return 0;
+    return AMP_POOL_M0 + pa - AMP_POOL_LINUX_PA;
+}
+static inline uint32_t amp_pool_m0_to_pa(uintptr_t va)
+{
+    if (va < AMP_POOL_M0 || va - AMP_POOL_M0 >= AMP_POOL_SIZE)
+        return 0;
+    return AMP_POOL_LINUX_PA + (uint32_t)(va - AMP_POOL_M0);
+}
+#endif
