diff --git a/bsp/rockchip/rk3576-mcu/applications/amp_echo.c b/bsp/rockchip/rk3576-mcu/applications/amp_echo.c
new file mode 100644
index 0000000..36ff0e7
--- /dev/null
+++ b/bsp/rockchip/rk3576-mcu/applications/amp_echo.c
@@ -0,0 +1,92 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+/* Host-build candidate only. Memory and mailbox gates must pass before boot. */
+#include <stdint.h>
+#include <string.h>
+
+#include <rtthread.h>
+#include "rpmsg_lite.h"
+#include "rpmsg_ns.h"
+#include "rpmsg_queue.h"
+#include "rpmsg_platform.h"
+#include "amp_contract.h"
+
+#define AMP_ECHO_LINK_ID AMP_LINK_ID
+#define AMP_ECHO_ENDPOINT 0x3004U
+#define AMP_ECHO_SERVICE AMP_SERVICE_NAME
+
+void amp_echo_run(void)
+{
+    struct rpmsg_lite_instance *instance;
+    struct rpmsg_lite_endpoint *endpoint;
+    rpmsg_queue_handle queue;
+    uint32_t src;
+    uint32_t len;
+    char message[RL_BUFFER_PAYLOAD_SIZE];
+    unsigned int heartbeat = 0;
+
+    rt_kprintf("amp-echo: waiting for Linux, link=0x%x\n", AMP_ECHO_LINK_ID);
+    instance = rpmsg_lite_remote_init((void *)(uintptr_t)RPMSG_LINUX_MEM_BASE,
+                                      AMP_ECHO_LINK_ID, RL_NO_FLAGS);
+    if (instance == RL_NULL)
+    {
+        rt_kprintf("amp-echo: remote init failed\n");
+        return;
+    }
+
+    while (rpmsg_lite_is_link_up(instance) != RL_TRUE)
+    {
+        rt_thread_mdelay(1000);
+        if (++heartbeat % 5U == 0U)
+            rt_kprintf("amp-echo: waiting for link (%u s)\n", heartbeat);
+    }
+    rt_kprintf("amp-echo: link up\n");
+
+    queue = rpmsg_queue_create(instance);
+    if (queue == RL_NULL)
+        goto deinit;
+    endpoint = rpmsg_lite_create_ept(instance, AMP_ECHO_ENDPOINT,
+                                     rpmsg_queue_rx_cb, queue);
+    if (endpoint == RL_NULL)
+        goto destroy_queue;
+    if (rpmsg_ns_announce(instance, endpoint, AMP_ECHO_SERVICE,
+                          RL_NS_CREATE) != RL_SUCCESS)
+        goto destroy_endpoint;
+
+    heartbeat = 0;
+    for (;;)
+    {
+        len = 0;
+        if (rpmsg_queue_recv(instance, queue, &src, message,
+                             sizeof(message), &len, 1000U) == RL_SUCCESS)
+        {
+            char *response = RT_NULL;
+            uint32_t response_len = 0;
+
+            if (len == 5U && memcmp(message, "HELLO", 5U) == 0)
+            {
+                response = "HELLO_ACK";
+                response_len = 9U;
+            }
+            else if (len == 4U && memcmp(message, "PING", 4U) == 0)
+            {
+                response = "PONG";
+                response_len = 4U;
+            }
+            if (response != RT_NULL &&
+                rpmsg_lite_send(instance, endpoint, src, response,
+                                response_len, 100U) != RL_SUCCESS)
+                rt_kprintf("amp-echo: send failed\n");
+        }
+        if (++heartbeat % 5U == 0U)
+            rt_kprintf("amp-echo: heartbeat link=%u\n",
+                       rpmsg_lite_is_link_up(instance));
+    }
+
+destroy_endpoint:
+    rpmsg_lite_destroy_ept(instance, endpoint);
+destroy_queue:
+    rpmsg_queue_destroy(instance, queue);
+deinit:
+    rpmsg_lite_deinit(instance);
+    rt_kprintf("amp-echo: endpoint init failed\n");
+}
