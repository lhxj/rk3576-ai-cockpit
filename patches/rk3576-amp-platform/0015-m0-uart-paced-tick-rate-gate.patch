+/* UART5 is the already-owned 115200 8N1 console. Use its physical TX
+ * pacing, never the RT tick, to distinguish the SDK's 32K/24M profiles.
+ * This is a coarse rate gate, not a precision oscillator calibration.
+ * Every added UART poll has a fixed read budget; no extra clocks/pins. */
+struct amp_tick_measurement
+{
+    uint32_t counts, wraps, irq_delta;
+    rt_tick_t tick_delta;
+};
+
+static rt_bool_t amp_uart_wait(uint32_t mask, rt_bool_t lsr)
+{
+    uint32_t i;
+    for (i = 0; i < 1048576U; ++i)
+        if ((lsr ? UART5->LSR : UART5->USR) & mask)
+            return RT_TRUE;
+    return RT_FALSE;
+}
+
+static void amp_tick_sample(struct amp_tick_measurement *m, uint32_t *previous)
+{
+    const uint32_t value = SysTick->VAL;
+    const uint32_t period = SysTick->LOAD + 1U;
+    if (value > *previous)
+    {
+        ++m->wraps;
+        m->counts += *previous + period - value;
+    }
+    else
+        m->counts += *previous - value;
+    *previous = value;
+}
+
+static rt_bool_t amp_tick_measure(const char *phase, struct amp_tick_measurement *m)
+{
+    /* Exactly 96 raw bytes per line, 64 lines = 6144 8N1 frames.
+     * Drain the shift register at both boundaries, independent of RT time. */
+    static const char line[] = "P030 pace ....................................................................................\r\n";
+    uint32_t i, j, previous, irq_before;
+    rt_tick_t tick_before;
+    rt_kprintf("P030 tick %s uart5 pace bytes=6144 baud=115200 frame_bits=10\n", phase);
+    if (!amp_uart_wait(UART_LSR_TEMT, RT_TRUE))
+        return RT_FALSE;
+    *m = (struct amp_tick_measurement){0};
+    previous = SysTick->VAL;
+    irq_before = amp_tick_isr_count;
+    tick_before = rt_tick_get();
+    for (i = 0; i < 64U; ++i)
+        for (j = 0; j < sizeof(line) - 1U; ++j)
+        {
+            if (!amp_uart_wait(UART_USR_TX_FIFO_NOT_FULL, RT_FALSE))
+                return RT_FALSE;
+            UART5->THR = (uint32_t)line[j];
+            amp_tick_sample(m, &previous);
+        }
+    if (!amp_uart_wait(UART_LSR_TEMT, RT_TRUE))
+        return RT_FALSE;
+    amp_tick_sample(m, &previous);
+    m->irq_delta = amp_tick_isr_count - irq_before;
+    m->tick_delta = rt_tick_get() - tick_before;
+    rt_kprintf("P030 tick %s counts=%u wraps=%u isr_delta=%u tick_delta=%u\n",
+               phase, (unsigned int)m->counts, (unsigned int)m->wraps,
+               (unsigned int)m->irq_delta, (unsigned int)m->tick_delta);
+    return RT_TRUE;
+}
