+        amp_tick_enable_status != HAL_OK || __get_PRIMASK() ||
+        HAL_NVIC_GetIRQHandler(SysTick_IRQn) != (NVIC_IRQHandler)tick_isr ||
+        amp_tick_isr_count == irq_before || rt_tick_get() == tick_before)
+    {
+        rt_kprintf("P030 STOP tick preflight failed; no RT delay or RPMsg initialization; cold recovery required\n");
+        return RT_FALSE;
+    }
