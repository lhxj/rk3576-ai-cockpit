+rt_bool_t amp_tick_preflight(void)
+{
+    uint32_t i, changed = 0, wraps = 0;
+    uint32_t previous = SysTick->VAL;
+    const uint32_t irq_before = amp_tick_isr_count;
+    const rt_tick_t tick_before = rt_tick_get();
