@@ -1197,6 +1207,12 @@ int boot_ramdisk_high(struct lmb *lmb, ulong rd_data, ulong rd_len,
 				puts("ramdisk - allocation error\n");
 				goto error;
 			}
+#ifdef CONFIG_AMP
+			if (amp_reserved_range_check(*initrd_start, rd_len)) {
+				puts("AMP: ramdisk relocation intersects remote-owned memory\n");
