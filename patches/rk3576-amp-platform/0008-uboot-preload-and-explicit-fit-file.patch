diff --git a/common/image-fdt.c b/common/image-fdt.c
index 2884880..ff0ee92 100644
--- a/common/image-fdt.c
+++ b/common/image-fdt.c
@@ -18,6 +18,9 @@
 #include <mapmem.h>
 #include <asm/io.h>
 #include <sysmem.h>
+#ifdef CONFIG_AMP
+#include <amp.h>
+#endif
 
 #ifndef CONFIG_SYS_FDT_PAD
 #define CONFIG_SYS_FDT_PAD 0x3000
@@ -257,7 +260,18 @@ int boot_relocate_fdt(struct lmb *lmb, char **of_flat_tree, ulong *of_size)
 
 	/* position on a 4K boundary before the alloc_current */
 	/* Pad the FDT by a specified amount */
+#ifdef CONFIG_AMP
+	if (*of_size > ~0UL - CONFIG_SYS_FDT_PAD)
+		goto error;
+#endif
 	of_len = *of_size + CONFIG_SYS_FDT_PAD;
+#ifdef CONFIG_AMP
+	/* Check the entire padded in-place buffer before any FDT writes. */
+	if (amp_reserved_range_check((ulong)fdt_blob, of_len)) {
+		puts("AMP: padded FDT source intersects remote-owned memory\n");
+		goto error;
+	}
+#endif
 
 	/* If fdt_high is set use it to select the relocation address */
 	fdt_high = env_get("fdt_high");
@@ -296,6 +310,12 @@ int boot_relocate_fdt(struct lmb *lmb, char **of_flat_tree, ulong *of_size)
 		puts("device tree - allocation error\n");
 		goto error;
 	}
+#ifdef CONFIG_AMP
+	if (amp_reserved_range_check((ulong)of_start, of_len)) {
+		puts("AMP: padded FDT destination intersects remote-owned memory\n");
+		goto error;
+	}
+#endif
 
 	if (disable_relocation) {
 		/*
@@ -655,6 +675,13 @@ int image_setup_libfdt(bootm_headers_t *images, void *blob,
 		lmb_reserve(lmb, (ulong)blob, of_size);
 
 	fdt_initrd(blob, *initrd_start, *initrd_end);
+#ifdef CONFIG_AMP
+	/* A software U-Boot reservation alone cannot protect Linux's allocator. */
+	if (amp_memory_guard_active() && amp_linux_fdt_check(blob, true)) {
+		printf("AMP: final Linux DT lacks exact active no-map remote regions\n");
+		goto err;
+	}
+#endif
 	if (!ft_verify_fdt(blob))
 		goto err;
 
diff --git a/common/image-fit.c b/common/image-fit.c
