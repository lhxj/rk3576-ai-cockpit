+void *sysmem_reserve_amp_region(const char *name, phys_addr_t base,
+			      phys_size_t size)
+{
+	struct sysmem *sysmem = &plat_sysmem;
+	struct lmb *lmb = &sysmem->lmb;
+	struct memblock *mem;
+	char *saved_name;
+	ulong i;
+	bool inside = false;
