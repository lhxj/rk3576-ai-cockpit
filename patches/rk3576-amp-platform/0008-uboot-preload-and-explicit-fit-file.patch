+/* PROJECT_ADDITION: explicit file loader on the existing named boot partition.
+ * It is never called automatically and never changes GPT or environment.
+ * Missing file, short read, policy failure or reserve failure cannot release M0.
+ * File bytes go only to a bounded U-Boot heap allocation, not a chosen RAM PA. */
+static int amp_m0_file(const char *filename, const void *linux_fdt)
+{
+	struct blk_desc *desc = rockchip_get_bootdev();
+	disk_partition_t boot;
+	char device_partition[32];
+	loff_t file_size, read_size;
+	void *fit;
+	int partition, ret;
+
+	if (amp_fdt_ram_range((ulong)linux_fdt, sizeof(struct fdt_header)) ||
+	    fdt_check_header(linux_fdt) ||
+	    amp_fdt_ram_range((ulong)linux_fdt, fdt_totalsize(linux_fdt)) ||
+	    amp_linux_fdt_check(linux_fdt, false))
+		return -EINVAL;
+	if (amp_load_attempted || !desc || desc->if_type != IF_TYPE_MMC)
+		return -ENODEV;
+	partition = part_get_info_by_name(desc, "boot", &boot);
+	if (partition < 0)
+		return -ENODEV;
+	snprintf(device_partition, sizeof(device_partition), "%d:%d",
+		 desc->devnum, partition);
+	if (fs_set_blk_dev("mmc", device_partition, FS_TYPE_ANY) ||
+	    fs_size(filename, &file_size))
+		return -ENOENT;
+	if (file_size < FIT_HEADER_SIZE || file_size > AMP_CODE_SIZE + SZ_64K)
+		return -EFBIG;
+	fit = memalign(ARCH_DMA_MINALIGN, ALIGN(file_size, ARCH_DMA_MINALIGN));
+	if (!fit)
+		return -ENOMEM;
+	if (amp_ranges_overlap((ulong)fit, file_size,
+			       (ulong)linux_fdt, fdt_totalsize(linux_fdt))) {
+		free(fit);
+		return -EINVAL;
+	}
+	/* fs_size closes the filesystem. Reselect before the one bounded read. */
+	ret = fs_set_blk_dev("mmc", device_partition, FS_TYPE_ANY);
+	if (!ret)
+		ret = fs_read(filename, (ulong)fit, 0, file_size, &read_size);
+	if (!ret && read_size != file_size)
+		ret = -EIO;
+	if (!ret)
+		ret = amp_boot_fit(fit, file_size);
+	free(fit);
+	return ret;
+}
+
+static int do_amp_m0load(cmd_tbl_t *cmdtp, int flag, int argc,
+			 char * const argv[])
+{
+	int ret;
+
+	if (argc != 3)
+		return CMD_RET_USAGE;
+	ret = amp_m0_file(argv[1], (void *)simple_strtoul(argv[2], NULL, 16));
+	if (ret)
+		AMP_E("file load rejected, ret=%d; no successful M0 start\n", ret);
+	return ret ? CMD_RET_FAILURE : CMD_RET_SUCCESS;
+}
+
+U_BOOT_CMD(amp_m0load, 3, 0, do_amp_m0load,
+	   "PROJECT: verified cold BUS M0 FIT from named boot partition",
+	   "<file> <linux_fdt_addr> - require prepared AMP Linux DT; cold start only");
