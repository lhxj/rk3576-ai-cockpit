diff --git a/drivers/cpu/rockchip_amp.c b/drivers/cpu/rockchip_amp.c
index 667d07d..6f6bd7e 100644
--- a/drivers/cpu/rockchip_amp.c
+++ b/drivers/cpu/rockchip_amp.c
@@ -9,6 +9,9 @@
 #include <boot_rkimg.h>
 #include <config.h>
 #include <sysmem.h>
+#include <fs.h>
+#include <lmb.h>
+#include <amp_project_contract.h>
 #include <asm/gic.h>
 #include <asm/io.h>
 #include <asm/arch/rockchip_smccc.h>
@@ -66,6 +69,276 @@ typedef struct boot_cpu {
 
 static boot_cpu_t g_bootcpu;
 static u32 os_amp_dispatcher_cpu[8];
+static bool amp_load_attempted;
+static bool amp_preload_reserved;
+static bool amp_remote_copy_active;
+
+bool amp_memory_guard_active(void)
+{
+	return amp_load_attempted;
+}
+
+static bool amp_ranges_overlap(u64 first, u64 first_size,
+			       u64 second, u64 second_size)
+{
+	if (!first_size || !second_size)
+		return false;
+	/* Treat malformed existing ranges as a conflict, never wrap. */
+	if (first > ~0ULL - first_size || second > ~0ULL - second_size)
+		return true;
+	return first < second + second_size && second < first + first_size;
+}
+
+static bool amp_fdt_node_enabled(const void *blob, int node)
+{
+	int len;
+	const char *status = fdt_getprop(blob, node, "status", &len);
+
+	if (!status)
+		return len == -FDT_ERR_NOTFOUND;
+	return (len == (int)sizeof("okay") &&
+		!memcmp(status, "okay", sizeof("okay"))) ||
+	       (len == (int)sizeof("ok") &&
+		!memcmp(status, "ok", sizeof("ok")));
+}
+
+int amp_linux_fdt_check(const void *blob, bool require_memory)
+{
+	const fdt32_t *cells, *reg;
+	const char *kind;
+	u64 base, size;
+	u32 bit, found = 0, memory = 0;
+	int parent, node, len, pos;
+
+	if (fdt_check_header(blob) || !amp_fdt_node_enabled(blob, 0))
+		return -EINVAL;
+	cells = fdt_getprop(blob, 0, "#address-cells", &len);
+	if (!cells || len != 4 || fdt32_to_cpu(*cells) != 2)
+		return -EINVAL;
+	cells = fdt_getprop(blob, 0, "#size-cells", &len);
+	if (!cells || len != 4 || fdt32_to_cpu(*cells) != 2)
+		return -EINVAL;
+	/* Linux /memory must actually contain both reserved physical ranges. */
+	fdt_for_each_subnode(node, blob, 0) {
+		kind = fdt_getprop(blob, node, "device_type", &len);
+		if (!kind || len != (int)sizeof("memory") ||
+		    memcmp(kind, "memory", sizeof("memory")) ||
+		    !amp_fdt_node_enabled(blob, node))
+			continue;
+		reg = fdt_getprop(blob, node, "reg", &len);
+		if (!reg || len <= 0 || len % 16)
+			return -EINVAL;
+		for (pos = 0; pos < len / 4; pos += 4) {
+			base = (u64)fdt32_to_cpu(reg[pos]) << 32 |
+			       fdt32_to_cpu(reg[pos + 1]);
+			size = (u64)fdt32_to_cpu(reg[pos + 2]) << 32 |
+			       fdt32_to_cpu(reg[pos + 3]);
+			if (!size || base > ~0ULL - size)
+				return -EINVAL;
+			if (base <= AMP_CODE_LINUX_PA &&
+			    base + size >= AMP_CODE_LINUX_PA + AMP_CODE_SIZE)
+				memory |= 1;
+			if (base <= AMP_SHARED_LINUX_PA &&
+			    base + size >= AMP_SHARED_LINUX_PA + AMP_SHARED_SIZE)
+				memory |= 2;
+		}
+	}
+	/* Stock kernel DTs can omit /memory until arch_fixup_fdt populates it.
+	 * The explicit loader checks actual gd banks; final Linux prep requires
+	 * the final /memory to cover the protected regions. Never invent it. */
+	if (require_memory && memory != 3)
+		return -EINVAL;
+	parent = fdt_path_offset(blob, "/reserved-memory");
+	if (parent < 0 || !amp_fdt_node_enabled(blob, parent))
+		return -EINVAL;
+	cells = fdt_getprop(blob, parent, "#address-cells", &len);
+	if (!cells || len != 4 || fdt32_to_cpu(*cells) != 2)
+		return -EINVAL;
+	cells = fdt_getprop(blob, parent, "#size-cells", &len);
+	if (!cells || len != 4 || fdt32_to_cpu(*cells) != 2)
+		return -EINVAL;
+	if (!fdt_getprop(blob, parent, "ranges", &len) || len != 0)
+		return -EINVAL;
+	fdt_for_each_subnode(node, blob, parent) {
+		if (!amp_fdt_node_enabled(blob, node))
+			continue;
+		reg = fdt_getprop(blob, node, "reg", &len);
+		if (!reg || len <= 0 || len % 16)
+			continue;
+		for (pos = 0; pos < len / 4; pos += 4) {
+			base = (u64)fdt32_to_cpu(reg[pos]) << 32 |
+			       fdt32_to_cpu(reg[pos + 1]);
+			size = (u64)fdt32_to_cpu(reg[pos + 2]) << 32 |
+			       fdt32_to_cpu(reg[pos + 3]);
+			if (!amp_ranges_overlap(base, size,
+			    AMP_CODE_LINUX_PA, AMP_CODE_SIZE) &&
+			    !amp_ranges_overlap(base, size,
+			    AMP_SHARED_LINUX_PA, AMP_SHARED_SIZE))
+				continue;
+			if (base == AMP_CODE_LINUX_PA && size == AMP_CODE_SIZE)
+				bit = 1;
+			else if (base == AMP_SHARED_LINUX_PA &&
+				 size == AMP_POOL_LINUX_PA - AMP_SHARED_LINUX_PA)
+				bit = 2;
+			else if (base == AMP_POOL_LINUX_PA && size == AMP_POOL_SIZE)
+				bit = 4;
+			else
+				return -EINVAL;
+			if (found & bit ||
+			    !fdt_getprop(blob, node, "no-map", &len) || len != 0 ||
+			    fdt_getprop(blob, node, "reusable", &len))
+				return -EINVAL;
+			found |= bit;
+		}
+	}
+	return found == 7 ? 0 : -EINVAL;
+}
+
+static int amp_fdt_ram_range(ulong base, size_t size)
+{
+	u64 start, bank_size;
+	int i;
+
+	/* Reject remote-owned source addresses even before AMP is active. */
+	if (!size || (u64)base > ~0ULL - size ||
+	    amp_ranges_overlap(base, size, AMP_CODE_LINUX_PA, AMP_CODE_SIZE) ||
+	    amp_ranges_overlap(base, size, AMP_SHARED_LINUX_PA, AMP_SHARED_SIZE))
+		return -EINVAL;
+	for (i = 0; i < CONFIG_NR_DRAM_BANKS; i++) {
+		start = gd->bd->bi_dram[i].start;
+		bank_size = gd->bd->bi_dram[i].size;
+		if (!bank_size || start > ~0ULL - bank_size)
+			continue;
+		if (base >= start && (u64)base + size <= start + bank_size)
+			return 0;
+	}
+	return -EINVAL;
+}
+
+int amp_reserved_range_check(phys_addr_t base, phys_size_t size)
+{
+	if (!amp_load_attempted)
+		return 0;
+	if (!size || (u64)base > ~0ULL - (u64)size ||
+	    amp_ranges_overlap(base, size, AMP_CODE_LINUX_PA, AMP_CODE_SIZE) ||
+	    amp_ranges_overlap(base, size, AMP_SHARED_LINUX_PA, AMP_SHARED_SIZE))
+		return -EBUSY;
+	return 0;
+}
+
+int amp_fit_copy_range_check(phys_addr_t base, phys_size_t size)
+{
+	/* Only the preflighted single MCU payload owns a narrow copy exception.
+	 * Subsequent Linux FIT loadables have no permission to overwrite it. */
+	if (amp_remote_copy_active && amp_preload_reserved &&
+	    base == AMP_CODE_LINUX_PA && size && size <= AMP_CODE_SIZE)
+		return 0;
+	return amp_reserved_range_check(base, size);
+}
+
+void amp_reserve_boot_lmb(struct lmb *lmb)
+{
+	if (!amp_load_attempted)
+		return;
+	/* bootm has a separate LMB, recreated for each Linux boot attempt. */
+	if (lmb_reserve(lmb, AMP_CODE_LINUX_PA, AMP_CODE_SIZE) < 0 ||
+	    lmb_reserve(lmb, AMP_SHARED_LINUX_PA, AMP_SHARED_SIZE) < 0)
+		panic("AMP: cannot protect remote regions in Linux boot LMB");
+}
+
+static int amp_preload_reserve(void)
+{
+	if (amp_load_attempted || !IS_ENABLED(CONFIG_SYSMEM) ||
+	    !sysmem_has_init())
+		return -EBUSY;
+	/* One attempt per cold boot; keep every successful reservation even if
+	 * a later reservation, hash, copy or secure setter fails. No hot restart. */
+	amp_load_attempted = true;
+	if (!sysmem_reserve_amp_region("PROJECT_BUS_M0_CODE",
+				      AMP_CODE_LINUX_PA, AMP_CODE_SIZE))
+		return -ENXIO;
+	if (!sysmem_reserve_amp_region("PROJECT_BUS_M0_SHARED",
+				      AMP_SHARED_LINUX_PA, AMP_SHARED_SIZE))
+		return -ENXIO;
+	amp_preload_reserved = true;
+	return 0;
+}
+
+static int amp_require_u32(const void *fit, int node, const char *property,
+			   u32 expected)
+{
+	int len;
+	const fdt32_t *value = fdt_getprop(fit, node, property, &len);
+
+	return value && len == (int)sizeof(*value) &&
+	       fdt32_to_cpu(*value) == expected ? 0 : -EINVAL;
+}
+
+static int amp_preflight_m0(const void *fit, size_t file_size)
+{
+	const char *name, *description;
+	const void *data;
+	const fdt32_t *shared;
+	const char *algo;
+	size_t data_size;
+	ulong load, entry;
+	u8 type, arch, compression;
+	int conf, node, len, total, hash, value_len;
+
+	if (amp_load_attempted || file_size < FIT_HEADER_SIZE ||
+	    file_size > AMP_CODE_SIZE + SZ_64K || fdt_check_header(fit) ||
+	    fdt_totalsize(fit) > file_size ||
+	    fit_get_totalsize(fit, &total) || total <= 0 ||
+	    (size_t)total != file_size)
+		return -EINVAL;
+	conf = fit_conf_get_node(fit, "conf");
+	if (conf < 0 || fdt_subnode_offset(fit, conf, "linux") >= 0 ||
+	    fdt_stringlist_count(fit, conf, FIT_LOADABLE_PROP) != 1)
+		return -EINVAL;
+	name = fdt_stringlist_get(fit, conf, FIT_LOADABLE_PROP, 0, &len);
+	if (!name || strcmp(name, "mcu"))
+		return -EINVAL;
+	node = fit_image_get_node(fit, name);
+	if (node < 0)
+		return node;
+	description = fdt_getprop(fit, node, "description", &len);
+	if (!description || len != sizeof("bus_mcu") ||
+	    memcmp(description, "bus_mcu", sizeof("bus_mcu")) ||
+	    fit_image_get_type(fit, node, &type) || type != IH_TYPE_STANDALONE ||
+	    fit_image_get_arch(fit, node, &arch) || arch != IH_ARCH_ARM ||
+	    fit_image_get_comp(fit, node, &compression) || compression != IH_COMP_NONE ||
+	    fit_image_get_load(fit, node, &load) || load != AMP_CODE_LINUX_PA ||
+	    fit_image_get_entry(fit, node, &entry) || entry != AMP_M0_LOCAL_ENTRY ||
+	    amp_require_u32(fit, node, "rockchip,mcu-code-size", AMP_CODE_SIZE) ||
+	    amp_require_u32(fit, node, "rockchip,mcu-shared-window-base",
+			    AMP_SHARED_WINDOW_LINUX_PA))
+		return -EINVAL;
+	shared = fdt_getprop(fit, node, "rockchip,mcu-shared-region", &len);
+	if (!shared || len != 2 * sizeof(*shared) ||
+	    fdt32_to_cpu(shared[0]) != AMP_SHARED_LINUX_PA ||
+	    fdt32_to_cpu(shared[1]) != AMP_SHARED_SIZE)
+		return -EINVAL;
+	if (fit_image_get_data(fit, node, &data, &data_size) ||
+	    !data_size || data_size > AMP_CODE_SIZE ||
+	    (uintptr_t)data < (uintptr_t)fit ||
+	    (uintptr_t)data - (uintptr_t)fit > file_size ||
+	    data_size > file_size - ((uintptr_t)data - (uintptr_t)fit) ||
+	    amp_ranges_overlap((uintptr_t)fit, file_size,
+			       AMP_CODE_LINUX_PA, AMP_CODE_SIZE) ||
+	    amp_ranges_overlap((uintptr_t)fit, file_size,
+			       AMP_SHARED_LINUX_PA, AMP_SHARED_SIZE))
+		return -EINVAL;
+	/* A hash-less FIT is not an integrity check. Require this known image's
+	 * SHA256 hash, even when board policy legitimately allows unsigned FIT. */
+	hash = fdt_subnode_offset(fit, node, "hash");
+	algo = hash < 0 ? NULL : fdt_getprop(fit, hash, "algo", &len);
+	if (!algo || len != sizeof("sha256") ||
+	    memcmp(algo, "sha256", sizeof("sha256")) ||
+	    !fdt_getprop(fit, hash, "value", &value_len) || value_len != 32 ||
+	    fdt_getprop(fit, hash, "ignore", NULL))
+		return -EINVAL;
+	return 0;
+}
 
 static u32 fit_get_u32_default(const void *fit, int noffset,
 			       const char *prop, u32 def)
@@ -236,8 +509,10 @@ static int standalone_handler(const void *fit, int noffset, const char *id,
 	if (data_size <= 0)
 		return -EINVAL;
 
-	if (!sysmem_alloc_base_by_name(id,
-			(phys_addr_t)entry_point, data_size))
+	/* The full remote regions were protected before fit_image_load copied.
+	 * Do not allocate a second BIN-sized alias after the copy. */
+	if (!amp_preload_reserved || strcmp(id, "bus_mcu") ||
+	    entry_point != AMP_CODE_LINUX_PA || data_size > AMP_CODE_SIZE)
 		return -ENXIO;
 
 	printf("Handle standalone: '%s' at 0x%08x ...", id, entry_point);
@@ -518,16 +793,56 @@ static int amp_verify_config_policy(const void *fit, const char *config)
 	return 0;
 }
 
+static int amp_boot_fit(void *fit, size_t file_size)
+{
+	bootm_headers_t images;
+	int node, ret;
+
+	/* Validate geometry/source bounds before verification reads payloads. */
+	ret = amp_preflight_m0(fit, file_size);
+	if (ret)
+		return ret;
+	ret = amp_verify_config_policy(fit, "conf");
+	if (ret)
+		return ret;
+	node = fit_image_get_node(fit, "mcu");
+	if (!fit_image_verify(fit, node))
+		return -EACCES;
+	ret = amp_preload_reserve();
+	if (ret)
+		return ret;
+	/* First possible payload write occurs only after both full reservations. */
+	memset(&images, 0, sizeof(images));
+	images.fit_uname_cfg = "conf";
+	images.fit_hdr_os = fit;
+	images.verify = 1;
+	amp_remote_copy_active = true;
+	ret = boot_get_loadable(0, NULL, &images, IH_ARCH_DEFAULT, NULL, NULL);
+	amp_remote_copy_active = false;
+	if (ret)
+		return ret;
+	flush_dcache_all();
+	ret = parse_os_amp_dispatcher();
+	if (ret)
+		return ret;
+	return brought_up_all_amp(images.fit_hdr_os, images.fit_uname_cfg);
+}
+
 int amp_cpus_on(void)
 {
 	struct blk_desc *dev_desc;
-	bootm_headers_t images;
 	disk_partition_t part;
 	void *hdr, *fit;
-	int offset, cnt;
+	lbaint_t offset;
+	ulong cnt;
 	int totalsize;
