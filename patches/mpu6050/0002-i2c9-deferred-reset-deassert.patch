+        HAL_CRU_ClkResetDeassert(SRST_RESETN_I2C9) != HAL_OK)
+        return -RT_ERROR;
     if (HAL_I2C_Init(&i2c->instance, i2c_dev->pReg, freq, speed) != HAL_OK)
         return -RT_ERROR;
