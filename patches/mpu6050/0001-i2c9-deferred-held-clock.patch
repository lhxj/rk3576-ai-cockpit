+#ifdef MPU_SENSOR_V1_I2C9_OWNERSHIP
+rt_err_t rockchip_i2c9_resource_ready(rt_tick_t timeout_ticks)
+{
+    rt_base_t level;
+    rt_err_t result;
+    /* Caller is the sensor control worker after the approved resource preflight.
+     * This API itself cannot establish firewall access or deployment approval. */
+    if (rt_interrupt_get_nest() || !timeout_ticks ||
+        timeout_ticks > rt_tick_from_millisecond(20))
+        return -RT_EINVAL;
+    level = rt_hw_interrupt_disable();
+    if (i2c9_owner_state != I2C9_WAIT_RESOURCE)
+    {
+        result = i2c9_init_result;
+        rt_hw_interrupt_enable(level);
+        return result;
+    }
+    i2c9_owner_state = I2C9_INITIALIZING;
+    rt_hw_interrupt_enable(level);
+    i2c9.bus.timeout = timeout_ticks;
+    result = rt_rockchip_i2c_probe(&i2c9, I2C_100K);
+    if (result != RT_EOK)
+        rt_hw_interrupt_mask(i2c9.dev->irqNum);
+    level = rt_hw_interrupt_disable();
+    i2c9_init_result = result;
+    i2c9_owner_state = result == RT_EOK ? I2C9_READY : I2C9_FAILED;
+    rt_hw_interrupt_enable(level);
+    return result;
+}
+#endif
